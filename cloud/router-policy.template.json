{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteMorsePiMessageObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::<bucket-name>/stations/*/messages/*",
        "arn:aws:s3:::<bucket-name>/stations/*/snapshots/students/*",
        "arn:aws:s3:::<bucket-name>/family/messaging/*",
        "arn:aws:s3:::<bucket-name>/family/student-summaries/*"
      ]
    },
    {
      "Sid": "ListMorsePiMessageObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<bucket-name>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "stations/*/messages/*",
            "stations/*/snapshots/students/*",
            "family/messaging/*",
            "family/student-summaries/*"
          ]
        }
      }
    },
    {
      "Sid": "WriteRouterLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:<region>:<account-id>:*"
    }
  ]
}
